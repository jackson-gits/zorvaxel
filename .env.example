# Copy this file to .env.local for local development.
# Keep these values server-side; do not prefix contact/email secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender identity. Configure this with an address verified in your Resend account.
RESEND_FROM_EMAIL=

# Set the actual public site origin only after a domain is configured.
# Leave blank during local development to avoid inventing a canonical URL.
NEXT_PUBLIC_SITE_URL=
